---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const s = messages.seasonStrategy ?? {};
const columns = s.columns ?? {};
const rows: any[] = Array.isArray(s.rows) ? s.rows : [];
---

<section id="seasons" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-4">
      {s.eyebrow && (
        <p class="text-xs sm:text-sm font-semibold tracking-[0.2em] uppercase mb-3" style="color: var(--accent);">
          {s.eyebrow}
        </p>
      )}
      <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-4" style="color: var(--text-primary);">
        {s.title}
      </h2>
      <p class="text-base sm:text-lg max-w-3xl mx-auto leading-relaxed" style="color: var(--text-secondary);">
        {s.subtitle}
      </p>
    </div>

    {s.sourceNote && (
      <p class="text-xs text-center max-w-3xl mx-auto mb-10 leading-relaxed" style="color: var(--text-muted);">
        📊 {s.sourceNote}
      </p>
    )}

    <div
      class="hidden md:block rounded-2xl overflow-hidden"
      style="border: 1px solid var(--border-color); box-shadow: var(--card-shadow);"
    >
      <table class="w-full text-left text-sm border-collapse">
        <thead>
          <tr style="background: var(--bg-tertiary);">
            <th class="p-4 font-semibold w-[14%] align-top" style="color: var(--text-primary);">{columns.season}</th>
            <th class="p-4 font-semibold w-[22%] align-top" style="color: var(--text-primary);">{columns.weather}</th>
            <th class="p-4 font-semibold w-[22%] align-top" style="color: var(--text-primary);">{columns.water}</th>
            <th class="p-4 font-semibold w-[20%] align-top" style="color: var(--text-primary);">{columns.wildlife}</th>
            <th class="p-4 font-semibold w-[22%] align-top" style="color: var(--text-primary);">{columns.advice}</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr style="border-top: 1px solid var(--border-color); background: var(--card-bg);">
              <td class="p-4 align-top">
                <span
                  class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold mb-2"
                  style="background: var(--tag-bg); color: var(--tag-text);"
                >
                  {r.tag}
                </span>
                <p class="font-semibold leading-snug" style="color: var(--text-primary);">{r.season}</p>
              </td>
              <td class="p-4 align-top leading-relaxed" style="color: var(--text-secondary);">{r.weather}</td>
              <td class="p-4 align-top leading-relaxed" style="color: var(--text-secondary);">{r.water}</td>
              <td class="p-4 align-top leading-relaxed" style="color: var(--text-secondary);">{r.wildlife}</td>
              <td class="p-4 align-top leading-relaxed" style="color: var(--text-secondary);">{r.advice}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="md:hidden space-y-4">
      {rows.map((r) => (
        <article
          class="rounded-2xl p-5"
          style="background: var(--card-bg); border: 1px solid var(--border-color); box-shadow: var(--card-shadow);"
        >
          <div class="flex items-center justify-between gap-3 mb-4">
            <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold" style="background: var(--tag-bg); color: var(--tag-text);">
              {r.tag}
            </span>
            <span class="font-semibold text-right" style="color: var(--text-primary);">{r.season}</span>
          </div>
          <dl class="space-y-3 text-sm">
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide mb-1" style="color: var(--accent);">{columns.weather}</dt>
              <dd class="leading-relaxed" style="color: var(--text-secondary);">{r.weather}</dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide mb-1" style="color: var(--accent);">{columns.water}</dt>
              <dd class="leading-relaxed" style="color: var(--text-secondary);">{r.water}</dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide mb-1" style="color: var(--accent);">{columns.wildlife}</dt>
              <dd class="leading-relaxed" style="color: var(--text-secondary);">{r.wildlife}</dd>
            </div>
            <div>
              <dt class="text-xs font-semibold uppercase tracking-wide mb-1" style="color: var(--accent);">{columns.advice}</dt>
              <dd class="leading-relaxed" style="color: var(--text-secondary);">{r.advice}</dd>
            </div>
          </dl>
        </article>
      ))}
    </div>
  </div>
</section>
