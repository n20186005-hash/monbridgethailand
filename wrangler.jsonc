{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monbridgethailand",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "SITE_URL": "https://monbridgethailand.com"
  }
}
